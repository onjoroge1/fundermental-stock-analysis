{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/admin/cron",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/admin/prices/cron/0/18",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/admin/prices/cron/18/18",
      "schedule": "20 22 * * 1-5"
    },
    {
      "path": "/api/admin/prices/cron/36/18",
      "schedule": "40 22 * * 1-5"
    },
    {
      "path": "/api/admin/prices/cron/0/25",
      "schedule": "0 23 * * 1-5"
    },
    {
      "path": "/api/admin/agent/cron/paper",
      "schedule": "2,12,22,32,42,52 * * * *"
    },
    {
      "path": "/api/admin/agent/cron/learning",
      "schedule": "10 0-3,22-23 * * *"
    },
    {
      "path": "/api/admin/agent/cron/progress",
      "schedule": "15 12,13 * * 1-5"
    }
  ],
  "functions": {
    "stock_machine/webapp_automation.py": {
      "maxDuration": 300
    }
  }
}
