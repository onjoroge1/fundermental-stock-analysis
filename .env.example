# Required for normalized data, reports, backtests, and paper portfolios.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# SEC fair-access identification. Use a real application name and contact.
SEC_USER_AGENT=StockMachine your-contact@example.com

# Optional: store generated raw data, bundles, reports, and predictions here.
# STOCK_MACHINE_DATA=/absolute/path/to/stock-machine-data

# Optional market/fundamental providers. Missing providers degrade explicitly.
# FMP_API_KEY=
# ALPHAVANTAGE_API_KEY=

# Optional, read-only IBKR Flex statement integration.
# Create a Flex Query containing Open Positions, Trades, and Cash Report.
# IBKR_FLEX_TOKEN=
# IBKR_FLEX_QUERY_ID=

# Optional, read-only IBKR Client Portal Gateway market data.
# Authenticate manually at https://localhost:5000 before using these endpoints.
IBKR_CP_BASE_URL=https://localhost:5000/v1/api
IBKR_CP_VERIFY_SSL=false
IBKR_CP_TIMEOUT_S=20
IBKR_CP_SNAPSHOT_WAIT_S=0.25
IBKR_CP_MIN_REQUEST_INTERVAL_S=0.11

# Optional, read-only TWS / IB Gateway socket market data (ibapi).
# Requires TWS or IB Gateway running with "Enable ActiveX and Socket Clients".
# Ports: 7497 TWS paper | 7496 TWS live | 4002 Gateway paper | 4001 Gateway live
IBKR_TWS_HOST=127.0.0.1
IBKR_TWS_PORT=7497
IBKR_TWS_CLIENT_ID=17
IBKR_TWS_TIMEOUT_S=12
# 1 live | 2 frozen | 3 delayed (no subscription needed) | 4 delayed-frozen
IBKR_TWS_MARKET_DATA_TYPE=3
