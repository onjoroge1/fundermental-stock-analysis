# Required for normalized data, reports, backtests, and paper portfolios.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# SEC fair-access identification. Use a real application name and contact.
SEC_USER_AGENT=StockMachine your-contact@example.com

# Optional: store generated raw data, bundles, reports, and predictions here.
# STOCK_MACHINE_DATA=/absolute/path/to/stock-machine-data

# Optional market/fundamental providers. Missing providers degrade explicitly.
# FMP_API_KEY=
# ALPHAVANTAGE_API_KEY=

# Optional, read-only IBKR Flex statement integration.
# Create a Flex Query containing Open Positions, Trades, and Cash Report.
# IBKR_FLEX_TOKEN=
# IBKR_FLEX_QUERY_ID=
