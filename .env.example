# Required for normalized data, reports, backtests, and paper portfolios.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth for PR32's write/orchestration API. Keep this server-side only.
# Generate a long random value, e.g. `openssl rand -hex 32`.
STOCK_MACHINE_ADMIN_TOKEN=replace-with-at-least-24-random-characters

# Optional Vercel Cron auth for /api/admin/jobs/process. Vercel sends
# Authorization: Bearer <CRON_SECRET> to configured cron paths.
CRON_SECRET=replace-with-at-least-24-random-characters

# SEC fair-access identification. Use a real application name and contact.
SEC_USER_AGENT=StockMachine your-contact@example.com

# Optional: store generated raw data, bundles, reports, and predictions here.
# STOCK_MACHINE_DATA=/absolute/path/to/stock-machine-data

# Optional market/fundamental providers. Missing providers degrade explicitly.
# FMP_API_KEY=
# ALPHAVANTAGE_API_KEY=

# Optional, read-only IBKR Flex statement integration.
# Create a Flex Query containing Open Positions, Trades, and Cash Report.
# IBKR_FLEX_TOKEN=
# IBKR_FLEX_QUERY_ID=

# Market-data provider: tws | client_portal | remote_bridge
# Local development with TWS/IB Gateway can use `tws`.
# Vercel production should use `remote_bridge`; when IBKR_PROVIDER is omitted,
# the app now infers remote_bridge only when both IBKR_BRIDGE_BASE_URL and
# IBKR_BRIDGE_TOKEN are configured.
IBKR_PROVIDER=tws

# Optional, read-only IBKR Client Portal Gateway market data.
# Authenticate manually at https://localhost:5000 before using these endpoints.
IBKR_CP_BASE_URL=https://localhost:5000/v1/api
IBKR_CP_VERIFY_SSL=false
IBKR_CP_TIMEOUT_S=20
IBKR_CP_SNAPSHOT_WAIT_S=0.25
IBKR_CP_MIN_REQUEST_INTERVAL_S=0.11

# Optional, read-only TWS / IB Gateway socket market data (ibapi).
# Requires TWS or IB Gateway running with "Enable ActiveX and Socket Clients".
# Keep "Read-Only API" enabled in TWS/IBGW for this market-data bridge.
# Ports: 7497 TWS paper | 7496 TWS live | 4002 Gateway paper | 4001 Gateway live
IBKR_TWS_HOST=127.0.0.1
IBKR_TWS_PORT=7497
IBKR_TWS_CLIENT_ID=17
IBKR_TWS_TIMEOUT_S=12
# 1 live | 2 frozen | 3 delayed (no subscription needed) | 4 delayed-frozen
IBKR_TWS_MARKET_DATA_TYPE=3

# Local bridge process (run on the same host as TWS / IB Gateway).
# Generate a long random secret, e.g. `openssl rand -hex 32`, and use the
# identical value in the cloud application's IBKR_BRIDGE_TOKEN.
IBKR_BRIDGE_TOKEN=replace-with-at-least-24-random-characters
IBKR_BRIDGE_HOST=127.0.0.1
IBKR_BRIDGE_PORT=8765

# Cloud/Vercel settings when IBKR_PROVIDER=remote_bridge.
# Use the stable HTTPS hostname published by your secure tunnel.
IBKR_BRIDGE_BASE_URL=https://ibkr-bridge.example.com
IBKR_BRIDGE_TIMEOUT_S=30
IBKR_BRIDGE_VERIFY_SSL=true

# Daily price history source: auto (broker, fall back to Yahoo) | tws | yahoo.
# On Vercel, prefer yahoo until the remote IBKR bridge is configured so a
# cloud ticker refresh does not waste time probing localhost TWS first.
PRICE_SOURCE=auto
IBKR_TWS_HIST_DURATION=15 Y
IBKR_TWS_HIST_SPACING_S=10
